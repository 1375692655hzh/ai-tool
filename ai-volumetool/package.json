{
  "name": "ai-volumetool",
  "productName": "ai-volume-pet",
  "version": "1.0.0",
  "description": "鲸鱼娘桌面宠物 · AI 渠道用量监控小工具（ai-tool 子项目）",
  "main": "main/main.js",
  "author": "1375692655hzh",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/1375692655hzh/ai-tool.git",
    "directory": "ai-volumetool"
  },
  "homepage": "https://github.com/1375692655hzh/ai-tool/tree/main/ai-volumetool#readme",
  "bugs": {
    "url": "https://github.com/1375692655hzh/ai-tool/issues"
  },
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis portable --publish never",
    "mock": "node tools/mock-server.js"
  },
  "devDependencies": {
    "electron": "^37.2.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.aivolumetool.pet",
    "productName": "AI用量宠物",
    "files": [
      "main/**/*",
      "renderer/**/*",
      "assets/**/*"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icon-256.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
